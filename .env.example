# Copy to .env.local and fill in. Nothing here is read by the browser: none of
# these are prefixed NEXT_PUBLIC_, so they stay on the server.

# Voice agent webhook. Until this is set, /api/lead validates and returns
# { ok: true, dispatched: false } without placing a call.
HERMES_WEBHOOK_URL=

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=
# Optional. Falls back to the database named in the connection string.
MONGO_DB_PROJECT_NAME=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# Accounts live in the `admin_users` collection with scrypt-hashed passwords;
# these two are read only by `npm run seed:admin`, which creates the account or
# resets its password. The app itself never reads them, so changing them here
# does nothing until you re-run the seed.
#
# The password is stored hashed, so it cannot be recovered — only replaced.
ADMIN_EMAIL=
ADMIN_PASSWORD=
