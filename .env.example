# Copy to .env.local and fill in. Nothing here is read by the browser: none of
# these are prefixed NEXT_PUBLIC_, so they stay on the server.

# Voice agent webhook. Until this is set, /api/lead validates and returns
# { ok: true, dispatched: false } without placing a call.
HERMES_WEBHOOK_URL=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# Placeholder auth: one account, password compared as plaintext. Fine for a
# staging login, not for anything worth protecting. Before this guards real
# data it needs hashed passwords and a shared rate limiter.

# Defaults to dev@taha.com / 123456 when unset — change both before deploying
# anywhere reachable.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the session cookie, so it cannot be forged by typing a value into
# devtools. Unset, a random secret is generated per process: sessions stay
# unforgeable but drop on restart and do not work across instances. Generate a
# stable one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=
