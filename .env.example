# ── Voice agent (ElevenLabs) ─────────────────────────────────────────────────
# What calls a lead back. The agent itself — prompt, model, voice, telephony —
# lives in the ElevenLabs dashboard; the site only places the call and records
# what happened.
#
# Without these three the lead form still validates and every submission is
# still stored and visible under Leads in the admin panel. Nothing is called,
# the lead is marked "No agent", and both the form and the dashboard say so
# rather than implying a phone rang.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The number the agent dials *from*, as registered in ElevenLabs — not the
# raw Twilio number. Find it under Agents → Phone numbers.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# `twilio` (default) for a number imported from Twilio, `sip` for one
# provisioned through ElevenLabs' own SIP trunk. The two are dialled through
# different endpoints and the wrong one returns a 404 that reads like a missing
# agent.
ELEVENLABS_CALL_TRANSPORT=twilio

# Signs the post-call webhook. Set the webhook in the ElevenLabs dashboard to:
#
#   https://bluex.agency/api/calls/webhook
#
# and paste the secret it generates here. That endpoint is public and it writes
# transcripts onto call records, so without this it refuses every request —
# an unsigned webhook is a way for anyone who finds the URL to put words in a
# customer's mouth. (The old /api/lead/callback path still works as a
# deprecated alias, but the dashboard should point at the new one.)
ELEVENLABS_WEBHOOK_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=
# Optional. Falls back to the database named in the connection string.
MONGO_DB_PROJECT_NAME=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# Accounts live in the `admin_users` collection with scrypt-hashed passwords;
# these two are read only by `npm run seed:admin`, which creates the account or
# resets its password. The app itself never reads them, so changing them here
# does nothing until you re-run the seed.
#
# The password is stored hashed, so it cannot be recovered — only replaced.
ADMIN_EMAIL=

# Signs the session cookie. Also the fallback salt for hashing submitter IP
# addresses, so leaving it unset means those are stored unhashed-equivalent —
# see lib/client-ip.ts. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Outgoing: the contact form's notification, and every reply sent from the
# admin inbox. Without SMTP_USER/SMTP_PASS the form still stores submissions
# and the inbox still shows them — only sending is disabled, and the UI says so.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Hostinger will not send as an address it does not authenticate, so this
# normally equals SMTP_USER. New submissions are announced to MAIL_TO.
MAIL_FROM=hello@bluex.agency
MAIL_TO=hello@bluex.agency

# Incoming: pulled into the admin inbox. Falls back to the SMTP credentials
# when unset, which is right for Hostinger — one mailbox, two protocols.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# ── Scheduled sync jobs ──────────────────────────────────────────────────────
# One secret, two cron jobs: mail and call reconciliation. Unset, both routes
# refuse every request rather than running open — an unauthenticated endpoint
# that opens an IMAP connection or calls a paid provider API is a way to
# exhaust the mail server, or someone else's bill, from outside.
#
#   */3 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://bluex.agency/api/cron/inbox-sync
#   */10 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://bluex.agency/api/cron/call-sync
#
# The admin panel's "Refresh" button runs the mail sync behind the session
# guard, so the inbox is usable before either of these is wired up. The Calls
# panel has the same fallback — its "Sync now" button calls
# /api/admin/calls/sync directly — so this cron is what keeps both current
# without anyone sitting in the dashboard clicking the button.
CRON_SECRET=

# Salts the one-way hash of submitter IP addresses. Optional — falls back to
# ADMIN_SESSION_SECRET. The IPv4 space is small enough to enumerate, so an
# unsalted digest of an address is reversible; with neither set, hashing is
# skipped rather than writing something that only looks protective.
IP_HASH_SALT=

# ── Image hosting (blog) ─────────────────────────────────────────────────────
# Cover images and in-post images upload to Cloudinary; the URL is what goes in
# MongoDB, never the bytes. Uploads are signed server-side, so the API secret is
# never sent to the browser and there is no public write endpoint on the account.
#
# Without these the admin editor still works — the upload button reports that
# hosting is unconfigured and the "paste an image URL" field beside it is the
# working path.
CLOUDINARY_CLOUD_NAME=vpzjs7df
CLOUDINARY_API_KEY=413633732397112
CLOUDINARY_API_SECRET=_WxAjW2TyX0Fj_0tlCdGBoyuRfY
# Optional. Where uploads land inside the account.
CLOUDINARY_FOLDER=bluex
