# Copy to .env.local and fill in. Nothing here is read by the browser: none of
# these are prefixed NEXT_PUBLIC_, so they stay on the server.

# Voice agent webhook. Until this is set, /api/lead validates and returns
# { ok: true, dispatched: false } without placing a call.
HERMES_WEBHOOK_URL=

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=
# Optional. Falls back to the database named in the connection string.
MONGO_DB_PROJECT_NAME=

# ── Admin area (/admin) ──────────────────────────────────────────────────────
# Accounts live in the `admin_users` collection with scrypt-hashed passwords;
# these two are read only by `npm run seed:admin`, which creates the account or
# resets its password. The app itself never reads them, so changing them here
# does nothing until you re-run the seed.
#
# The password is stored hashed, so it cannot be recovered — only replaced.
ADMIN_EMAIL=

# Signs the session cookie. Also the fallback salt for hashing submitter IP
# addresses, so leaving it unset means those are stored unhashed-equivalent —
# see lib/client-ip.ts. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────────
# Outgoing: the contact form's notification, and every reply sent from the
# admin inbox. Without SMTP_USER/SMTP_PASS the form still stores submissions
# and the inbox still shows them — only sending is disabled, and the UI says so.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Hostinger will not send as an address it does not authenticate, so this
# normally equals SMTP_USER. New submissions are announced to MAIL_TO.
MAIL_FROM=hello@bluex.agency
MAIL_TO=hello@bluex.agency

# Incoming: pulled into the admin inbox. Falls back to the SMTP credentials
# when unset, which is right for Hostinger — one mailbox, two protocols.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# ── Scheduled mail sync ──────────────────────────────────────────────────────
# Point a cron at POST /api/cron/inbox-sync every 2–5 minutes, sending
# `Authorization: Bearer <CRON_SECRET>`. Unset, the route refuses every
# request rather than running open — an unauthenticated endpoint that opens an
# IMAP connection is a way to exhaust the mail server from outside.
#
#   */3 * * * * curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://bluex.agency/api/cron/inbox-sync
#
# The admin panel's "Refresh" button runs the same sync behind the session
# guard, so the inbox is usable before this is wired up.
CRON_SECRET=

# Salts the one-way hash of submitter IP addresses. Optional — falls back to
# ADMIN_SESSION_SECRET. The IPv4 space is small enough to enumerate, so an
# unsalted digest of an address is reversible; with neither set, hashing is
# skipped rather than writing something that only looks protective.
IP_HASH_SALT=

# ── Image hosting (blog) ─────────────────────────────────────────────────────
# Cover images and in-post images upload to Cloudinary; the URL is what goes in
# MongoDB, never the bytes. Uploads are signed server-side, so the API secret is
# never sent to the browser and there is no public write endpoint on the account.
#
# Without these the admin editor still works — the upload button reports that
# hosting is unconfigured and the "paste an image URL" field beside it is the
# working path.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Where uploads land inside the account.
CLOUDINARY_FOLDER=bluex/blog
